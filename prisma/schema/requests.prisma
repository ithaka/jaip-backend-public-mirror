model request_permissions {
  id                                Int                 @id @default(autoincrement())
  facility_id                       Int                 @unique
  admin_id                          Int
  start_date                        DateTime            @default(now()) @db.Timestamp(6)
  end_date                          DateTime?           @db.Timestamp(6)
  created_at                        DateTime            @default(now()) @db.Timestamp(6)
  updated_at                        DateTime            @default(now()) @db.Timestamp(6)
  facilities                        facilities          @relation(fields: [facility_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  admins                            users               @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}