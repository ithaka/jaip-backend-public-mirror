# vulnerability in brace-expansion, which is a transitive dependency,
# and the vulnerable code isn't exposed here
CVE-2026-14257 exp:2026-10-31

# vulnerability in ip-address. It's in the base node image, but we're not using it.
CVE-2026-69192 exp:2026-10-31

# vulnerability in brace-expansion, in the npm internals
CVE-2026-69152 exp:2026-10-31

# vulnerability in tar, bundled inside npm itself (not our own dependency tree -
# not in yarn.lock). No npm release bundles the fixed tar version yet. We don't
# extract untrusted archives at runtime (we only run `node dist/server.js`), so
# this shouldn't affect us. Re-check when npm ships a release with tar >=7.5.21.
CVE-2026-73566 exp:2026-09-30

# vulnerabilities in libcrypto and libssl affecting QUIC servers, which we are not
CVE-2026-14456 exp:2026-10-01

# vulnerability in find-my-way, but it only affects http/2 servers, which this is not
CVE-2026-47219 exp:2026-10-31
